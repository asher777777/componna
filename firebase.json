{
  "hosting": {
    "site": "compona",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/kesher-proxy",
        "function": "kesherProxy"
      },
      {
        "source": "/api/tiktok-webhook",
        "function": "tiktokWebhook"
      },
      {
        "source": "/media/**",
        "function": "mediaProxy"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
