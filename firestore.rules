rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || request.auth.token.admin == true);
    }

    function isEditor() {
      return isSignedIn() && (getUserRole() in ['admin', 'editor']);
    }

    function isViewer() {
      return isSignedIn() && (getUserRole() in ['admin', 'editor', 'viewer']);
    }

    // 1. Users collection: User profile & roles management
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Global System Settings & Configurations
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Interactive Flow Player Engine Campaigns & Scenes
    match /sdo_player_campaign_configs/{slug} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();

      match /scenes/{sceneId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isSignedIn();
      }

      match /{document=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 4. Media Vault & Gallery Hub
    match /sdo_media_vault/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    match /sdo_media_items/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    match /sdo_media_folders/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // 5. Video Studio Projects
    match /sdo_video_projects/{projectId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // 6. Page Builder & Smart Forms
    match /mod_pagebuilder_pages/{pageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    match /mod_forms/{formId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    match /mod_form_submissions/{subId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // 7. Kesher Transactions & Clearing
    match /kesher_transactions/{txId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // 8. WhatsApp & CRM Groups
    match /wa_bots/{botId} {
      allow read, write: if true;
    }

    match /wa_webhook_config/{configId} {
      allow read, write: if true;
    }

    match /crm_groups/{groupId} {
      allow read, write: if true;
    }

    match /contacts/{contactId} {
      allow read, write: if true;
    }

    match /client_platform_config/{clientId} {
      allow read, write: if true;
    }

    // 9. Session Events & Analytics Telemetry
    match /sdo_player_session_events/{sessionId} {
      allow read, write: if true;
    }

    match /session_events/{sessionId} {
      allow read, write: if true;
    }

    // 10. General Fallback for all other database collections
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
