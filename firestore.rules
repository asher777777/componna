rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || request.auth.token.admin == true);
    }

    function isEditor() {
      return isSignedIn() && (getUserRole() in ['admin', 'editor']);
    }

    function isViewer() {
      return isSignedIn() && (getUserRole() in ['admin', 'editor', 'viewer']);
    }

    // 1. Users collection: User profile & roles management
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Interactive Flow Player Engine Campaigns & Scenes
    match /sdo_player_campaign_configs/{slug} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();

      match /scenes/{sceneId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isSignedIn();
      }

      match /{document=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 3. Media Vault & Gallery Hub
    match /sdo_media_vault/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // 4. Session Events & Analytics Telemetry
    match /sdo_player_session_events/{sessionId} {
      allow read, write: if true;
    }

    match /session_events/{sessionId} {
      allow read, write: if true;
    }

    // 5. General Fallback for all other database collections
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
